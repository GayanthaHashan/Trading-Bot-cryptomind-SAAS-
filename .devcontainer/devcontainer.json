
{
  "name": "CryptoMind AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {"version": "3.10"}
  },
  "postCreateCommand": "pip install -r backend/requirements.txt || pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "CryptoMind Backend", "onAutoForward": "open", "visibility": "public"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
